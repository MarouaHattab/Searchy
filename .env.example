
# ============================================================
# SEARCHY - ENVIRONMENT CONFIGURATION
# ============================================================

# ------------------------------------------------------------
# 1. STORAGE & DATA PATHS
# ------------------------------------------------------------
DATA_DIR=var
IMPORT_ROOT=data/episodes_splitted
EPISODE_MEDIA_DIR=data/episodes
CHARACTER_REFERENCE_DIR=data/meta
# Optional local face models; keep downloaded weights outside Git.
FACE_DETECTOR_PATH=
FACE_RECOGNIZER_PATH=
FACE_MATCH_THRESHOLD=0.5
FACE_MATCH_MARGIN=0.08
MODEL_CACHE_DIR=.cache/models


# ------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# ------------------------------------------------------------

# Neo4j - Graph Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Qdrant - Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=searchy_scenes


# ------------------------------------------------------------
# 3. LLM CONFIGURATION
# ------------------------------------------------------------
LLM_PROVIDER=GOOGLE_GENAI
LLM_MODEL_ID=gemini-3.5-flash-lite

# API Keys
GEMINI_API_KEY=
GROQ_API_KEY=


# ------------------------------------------------------------
# 4. EMBEDDING CONFIGURATION
# ------------------------------------------------------------
EMBEDDING_PROVIDER=LOCAL_EMBEDDING
EMBEDDING_MODEL_ID=google/embeddinggemma-300m
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=16


# ------------------------------------------------------------
# 5. HUGGING FACE CONFIGURATION
# ------------------------------------------------------------
HF_TOKEN=

# Legacy compatibility setting; ignored by modern Xet-based transfers.
HF_HUB_ENABLE_HF_TRANSFER=1


# ------------------------------------------------------------
# 6. VISUAL SEARCH CONFIGURATION
# ------------------------------------------------------------
VISUAL_ENABLED=false
VISUAL_MODEL_ID=clip-ViT-B-32


# ------------------------------------------------------------
# 7. AUDIO TRANSCRIPTION CONFIGURATION
# ------------------------------------------------------------
WHISPER_MODEL_ID=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8


# ------------------------------------------------------------
# 8. VIDEO PROCESSING CONFIGURATION
# ------------------------------------------------------------

# FFmpeg
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Upload & Video Limits
MAX_UPLOAD_MB=2048
MAX_VIDEO_SECONDS=14400

# Frame Sampling (character recognition and visual search)
# Chunk length is fixed at 60 seconds; see processing/chunking.py.
FRAMES_PER_SCENE=3
WORKER_ENABLED=true


# ------------------------------------------------------------
# 9. VISION LANGUAGE MODEL CONFIGURATION
# ------------------------------------------------------------

# Optional override:
# Gemini defaults to 10 images; Groq defaults to 3.
# Limits include reference images.
# VLM_MAX_IMAGES=3

# Which model captions a chunk during preparation, for uploads and imports alike.
#   api   - Gemini or Groq, sampling stills (needs a provider key, no GPU)
#   local - Qwen3-VL via vLLM, watching the whole clip (needs --extra preprocess)
CAPTION_BACKEND=api
# Captioning is independent of LLM_PROVIDER, which stays with answer generation.
#   GOOGLE_GENAI | GROQ
CAPTION_PROVIDER=GOOGLE_GENAI
# Model id for CAPTION_BACKEND=api. Empty uses LLM_MODEL_ID.
# A Groq vision model is required when CAPTION_PROVIDER=GROQ, e.g. qwen/qwen3.8-27b.
CAPTION_API_MODEL_ID=
# Model id for CAPTION_BACKEND=local. Empty uses the in-process default.
CAPTION_MODEL_ID=
# Minimum confidence before a caption may name a registered character.
VLM_IDENTITY_MIN_CONFIDENCE=0.85
# local backend only: an OpenAI-compatible server to call instead of loading
# vLLM in-process, e.g. an LM Studio server holding a Qwen3-VL GGUF.
# VLLM_BASE_URL=http://127.0.0.1:1234/v1


# ------------------------------------------------------------
# 10. SEARCH & SIMILARITY THRESHOLDS
# ------------------------------------------------------------
SEMANTIC_MIN_SCORE=0.45
VISUAL_MIN_SCORE=0.23
