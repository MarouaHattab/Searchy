
# ============================================================
# SEARCHY - ENVIRONMENT CONFIGURATION
# ============================================================

# ------------------------------------------------------------
# 1. STORAGE & DATA PATHS
# ------------------------------------------------------------
DATA_DIR=var
IMPORT_ROOT=data/episodes_splitted
EPISODE_MEDIA_DIR=data/episodes
CHARACTER_REFERENCE_DIR=data/meta
# Optional local face models; keep downloaded weights outside Git.
FACE_DETECTOR_PATH=
FACE_RECOGNIZER_PATH=
FACE_MATCH_THRESHOLD=0.5
FACE_MATCH_MARGIN=0.08
MODEL_CACHE_DIR=.cache/models


# ------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# ------------------------------------------------------------

# Neo4j - Graph Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Qdrant - Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=searchy_scenes


# ------------------------------------------------------------
# 3. LLM CONFIGURATION
# ------------------------------------------------------------
LLM_PROVIDER=GOOGLE_GENAI
LLM_MODEL_ID=gemini-3.5-flash-lite

# API Keys
GEMINI_API_KEY=
GROQ_API_KEY=


# ------------------------------------------------------------
# 4. EMBEDDING CONFIGURATION
# ------------------------------------------------------------
EMBEDDING_PROVIDER=LOCAL_EMBEDDING
EMBEDDING_MODEL_ID=google/embeddinggemma-300m
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=16


# ------------------------------------------------------------
# 5. HUGGING FACE CONFIGURATION
# ------------------------------------------------------------
HF_TOKEN=

# Legacy compatibility setting; ignored by modern Xet-based transfers.
HF_HUB_ENABLE_HF_TRANSFER=1


# ------------------------------------------------------------
# 6. VISUAL SEARCH CONFIGURATION
# ------------------------------------------------------------
VISUAL_ENABLED=false
VISUAL_MODEL_ID=clip-ViT-B-32


# ------------------------------------------------------------
# 7. AUDIO TRANSCRIPTION CONFIGURATION
# ------------------------------------------------------------
WHISPER_MODEL_ID=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8


# ------------------------------------------------------------
# 8. VIDEO PROCESSING CONFIGURATION
# ------------------------------------------------------------

# FFmpeg
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Upload & Video Limits
MAX_UPLOAD_MB=2048
MAX_VIDEO_SECONDS=14400

# Scene Segmentation
SCENE_MIN_SECONDS=8
SCENE_MAX_SECONDS=60
FRAMES_PER_SCENE=3
WORKER_ENABLED=true


# ------------------------------------------------------------
# 9. VISION LANGUAGE MODEL CONFIGURATION
# ------------------------------------------------------------

# Optional override:
# Gemini defaults to 10 images; Groq defaults to 3.
# Limits include reference images.
# VLM_MAX_IMAGES=3


# ------------------------------------------------------------
# 10. SEARCH & SIMILARITY THRESHOLDS
# ------------------------------------------------------------
SEMANTIC_MIN_SCORE=0.45
VISUAL_MIN_SCORE=0.23
