DATA_DIR=var
IMPORT_ROOT=data/episodes_splitted
CHARACTER_REFERENCE_DIR=data/meta

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=searchy_scenes
QDRANT_API_KEY=

LLM_PROVIDER=GOOGLE_GENAI
LLM_MODEL_ID=gemini-2.5-flash-lite
GEMINI_API_KEY=
GROQ_API_KEY=
EMBEDDING_PROVIDER=LOCAL_EMBEDDING
EMBEDDING_MODEL_ID=google/embeddinggemma-300m
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=16
MODEL_CACHE_DIR=.cache/models
HF_TOKEN=
# Accepted for compatibility; modern huggingface_hub uses Xet and ignores this flag.
HF_HUB_ENABLE_HF_TRANSFER=1
VISUAL_ENABLED=false
VISUAL_MODEL_ID=clip-ViT-B-32

WHISPER_MODEL_ID=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MAX_UPLOAD_MB=2048
MAX_VIDEO_SECONDS=14400
SCENE_MIN_SECONDS=8
SCENE_MAX_SECONDS=60
FRAMES_PER_SCENE=3
# Optional override; defaults are 10 for Gemini and 3 for Groq, including references.
# VLM_MAX_IMAGES=3
SEMANTIC_MIN_SCORE=0.45
VISUAL_MIN_SCORE=0.23
# Optional X-API-Key gate. Bind to localhost when unset.
API_KEY=
