# ============================================================
# SEARCHY - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ============================================================
# Copy this file to .env and fill in your API keys:
#   cp .env.example .env

# ------------------------------------------------------------
# 1. STORAGE & DATA PATHS
# ------------------------------------------------------------
DATA_DIR=var
DATABASE_PATH=var/searchy.sqlite3
COLLECTION_ID=friends
IMPORT_ROOT=data/episodes_splitted
EPISODE_MEDIA_DIR=data/episodes
CHARACTER_REFERENCE_DIR=data/meta
MODEL_CACHE_DIR=.cache/models

# Optional local face models (YuNet and SFace ONNX)
FACE_DETECTOR_PATH=.cache/models/faces/face_detection_yunet_2023mar.onnx
FACE_RECOGNIZER_PATH=.cache/models/faces/face_recognition_sface_2021dec.onnx
FACE_MATCH_THRESHOLD=0.38
FACE_MATCH_MARGIN=0.05


# ------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# ------------------------------------------------------------

# Neo4j - Graph Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Qdrant - Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=searchy_scenes
QDRANT_EPISODE_COLLECTION_NAME=searchy_episodes


# ------------------------------------------------------------
# 3. LLM CONFIGURATION
# ------------------------------------------------------------
# Options: NVIDIA_NIM | GOOGLE_GENAI | GROQ
LLM_PROVIDER=NVIDIA_NIM
LLM_MODEL_ID=nvidia/nemotron-3.5-bolt-e4b

# API Keys (Provide the key corresponding to your chosen LLM_PROVIDER)
GEMINI_API_KEY=
GROQ_API_KEY=
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=nvidia/nemotron-3.5-bolt-e4b


# ------------------------------------------------------------
# 4. EMBEDDING CONFIGURATION
# ------------------------------------------------------------
EMBEDDING_PROVIDER=LOCAL_EMBEDDING
EMBEDDING_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=16


# ------------------------------------------------------------
# 5. HUGGING FACE CONFIGURATION
# ------------------------------------------------------------
HF_TOKEN=

# Legacy compatibility; modern Xet transfers ignore this flag.
HF_HUB_ENABLE_HF_TRANSFER=1


# ------------------------------------------------------------
# 6. VISUAL SEARCH CONFIGURATION
# ------------------------------------------------------------
VISUAL_ENABLED=false
VISUAL_MODEL_ID=clip-ViT-B-32


# ------------------------------------------------------------
# 7. AUDIO TRANSCRIPTION CONFIGURATION
# ------------------------------------------------------------
WHISPER_MODEL_ID=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8


# ------------------------------------------------------------
# 8. VIDEO PROCESSING CONFIGURATION
# ------------------------------------------------------------

# FFmpeg Executables (Use 'ffmpeg' / 'ffprobe' or absolute path if not in system PATH)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Upload & Video Limits
MAX_UPLOAD_MB=2048
MAX_VIDEO_SECONDS=14400

# Scene Segmentation & Sampling
FRAMES_PER_SCENE=3
WORKER_ENABLED=true


# ------------------------------------------------------------
# 9. CAPTIONING & VLM CONFIGURATION
# ------------------------------------------------------------
# Backend: api (Gemini/Groq) | local (vLLM / LM Studio)
CAPTION_BACKEND=api
# Provider: GROQ | GOOGLE_GENAI
CAPTION_PROVIDER=GROQ
CAPTION_API_MODEL_ID=qwen/qwen3.8-27b
CAPTION_MODEL_ID=
VLM_IDENTITY_MIN_CONFIDENCE=0.85
VLLM_BASE_URL=http://127.0.0.1:11434/v1


# ------------------------------------------------------------
# 10. CHAT ASSISTANT CONFIGURATION
# ------------------------------------------------------------
CHAT_MODEL=nvidia/nemotron-3.5-bolt-e4b
CHAT_CONTEXT=8192
CHAT_MAX_TOKENS=1500
CHAT_TEMPERATURE=0.2
CHAT_SOURCE_LIMIT=20


# ------------------------------------------------------------
# 11. SEARCH & SIMILARITY THRESHOLDS
# ------------------------------------------------------------
SEMANTIC_MIN_SCORE=0.32
VISUAL_MIN_SCORE=0.23

# ------------------------------------------------------------
# 12. CORS CONFIGURATION
# ------------------------------------------------------------
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
